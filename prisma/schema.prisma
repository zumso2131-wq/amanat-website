// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CLIENT
}

enum DealStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELED
}

enum InstallmentStatus {
  DUE
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum DocumentType {
  CONTRACT
  SCHEDULE
}

model User {
  id           String   @id @default(cuid())
  role         UserRole @default(CLIENT)
  phone        String   @unique
  passwordHash String
  fullName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  dealsCreated    Deal[]       @relation("DealCreator")
  paymentsCreated Payment[]    @relation("PaymentCreator")
  notifications   Notification[]
  auditLogs       AuditLog[]   @relation("AuditActor")

  @@index([phone])
  @@index([role])
  @@map("users")
}

model Client {
  id               String   @id @default(cuid())
  fullName         String
  phone            String
  passportNumber   String?
  passportIssuedBy String?
  passportIssuedAt DateTime?
  address          String?
  note             String?
  createdAt        DateTime @default(now())

  deals    Deal[]

  @@index([phone])
  @@index([fullName])
  @@map("clients")
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  sku                String?  @unique
  category           String?
  defaultPurchasePrice Decimal @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  @@index([name])
  @@index([sku])
  @@map("products")
}

model Deal {
  id                    String     @id @default(cuid())
  clientId              String
  productName           String
  purchasePrice         Decimal    @db.Decimal(12, 2)
  markupPercentFinal    Decimal    @db.Decimal(5, 2)
  salePrice             Decimal    @db.Decimal(12, 2)
  downPayment           Decimal    @default(0) @db.Decimal(12, 2)
  amountToFinance       Decimal    @db.Decimal(12, 2)
  months                Int
  startDate             DateTime
  monthlyBasePayment    Decimal    @db.Decimal(12, 2)
  lastPaymentAdjustment Decimal    @default(0) @db.Decimal(12, 2)
  status                DealStatus @default(DRAFT)
  createdByUserId       String
  createdAt             DateTime   @default(now())

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser User          @relation("DealCreator", fields: [createdByUserId], references: [id])
  installments  Installment[]
  payments      Payment[]
  documents     Document[]

  @@index([clientId])
  @@index([status])
  @@index([createdByUserId])
  @@index([startDate])
  @@map("deals")
}

model Installment {
  id         String            @id @default(cuid())
  dealId     String
  index      Int
  dueDate    DateTime
  amount     Decimal           @db.Decimal(12, 2)
  status     InstallmentStatus @default(DUE)
  paidAt     DateTime?
  createdAt  DateTime          @default(now())

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([dealId, index])
  @@index([dealId])
  @@index([dueDate])
  @@index([status])
  @@map("installments")
}

model Payment {
  id            String        @id @default(cuid())
  dealId        String
  installmentId String?
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime      @default(now())
  method        PaymentMethod @default(CASH)
  comment       String?
  createdByUserId String
  createdAt     DateTime      @default(now())

  deal         Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  installment  Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  createdByUser User      @relation("PaymentCreator", fields: [createdByUserId], references: [id])

  @@index([dealId])
  @@index([installmentId])
  @@index([paidAt])
  @@map("payments")
}

model Document {
  id            String       @id @default(cuid())
  dealId        String
  type          DocumentType
  filePathOrUrl String
  createdAt     DateTime     @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([type])
  @@map("documents")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payloadJson Json
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  entity      String
  entityId    String
  action      String
  diffJson    Json?
  createdAt   DateTime @default(now())

  actorUser User @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
